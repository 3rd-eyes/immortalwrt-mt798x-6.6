@@ -629,6 +629,45 @@
 	return TRUE;
 }
 
+#ifdef BAND_STEERING
+static int SendSteeringEvent(RTMP_ADAPTER *pAd, const char *if_name, unsigned char *sta_addr)
+{
+    struct sk_buff *skb_out;
+    struct nlmsghdr *nlh;
+    int res;
+    struct steering_event_data msg_data;
+
+    if (!pAd->netlink_sock) {
+        MTWF_DBG(pAd, DBG_CAT_AP, DBG_SUBCAT_ALL, DBG_LVL_ERROR, "Band steering netlink socket is not ready.\n");
+        return -1;
+    }
+    
+    strncpy(msg_data.if_name, if_name, IFNAMSIZ);
+    memcpy(msg_data.sta_addr, sta_addr, MAC_ADDR_LEN);
+
+    skb_out = nlmsg_new(sizeof(msg_data), GFP_ATOMIC);
+    if (!skb_out) {
+        MTWF_DBG(pAd, DBG_CAT_AP, DBG_SUBCAT_ALL, DBG_LVL_ERROR, "Failed to allocate new skb\n");
+        return -ENOMEM;
+    }
+
+    nlh = nlmsg_put(skb_out, 0, 0, NLMSG_DONE, sizeof(msg_data), 0);
+    memcpy(nlmsg_data(nlh), &msg_data, sizeof(msg_data));
+
+    res = nlmsg_multicast(pAd->netlink_sock, skb_out, 0, STEERING_GROUP, GFP_ATOMIC);
+    if (res < 0) {
+		if (res == -3) {
+			MTWF_DBG(pAd, DBG_CAT_AP, DBG_SUBCAT_ALL, DBG_LVL_ERROR, "No daemon listening on band steering netlink socket\n");
+			return res;
+		}
+        MTWF_DBG(pAd, DBG_CAT_AP, DBG_SUBCAT_ALL, DBG_LVL_ERROR, "Unknown band steering netlink multicast error: %d\n", res);
+    } else {
+        MTWF_DBG(pAd, DBG_CAT_AP, DBG_SUBCAT_ALL, DBG_LVL_INFO, "Band steering event sent for "MACSTR"\n", MAC2STR(sta_addr));
+    }
+    
+    return res;
+}
+#endif /* BAND_STEERING */
 
