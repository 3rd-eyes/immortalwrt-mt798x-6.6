 #endif
 #endif /* IGMP_SNOOP_SUPPORT */
+
+#ifdef BAND_STEERING
+	if (pAd->netlink_sock) {
+	    netlink_kernel_release(pAd->netlink_sock);
+    	pAd->netlink_sock = NULL;
+	}
+#endif /* BAND_STEERING */
 }
 
