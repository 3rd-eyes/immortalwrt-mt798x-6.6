+    		if (WMODE_CAP_2G(pEntry->wdev->PhyMode)) {
+        		snprintf(if_name, IFNAMSIZ, "ra0");
+    		} else {
+        		snprintf(if_name, IFNAMSIZ, "rax0");
+    		}
+    		SendSteeringEvent(pAd, if_name, pEntry->Addr);
+		}
+#endif /* BAND_STEERING */
+
 		if ( pEntry->RssiSample.Rssi_Updated && pMbss->RssiLowForStaKickOut &&
 			(avgRssi < pMbss->RssiLowForStaKickOut)) {
 			bDisconnectSta = TRUE;
@@ -7090,6 +7147,17 @@
 			ops->set_csi_cn_info(pAd, u1BandIdx);
 #endif /* WIFI_CSI_CN_INFO_SUPPORT */
 
+#ifdef BAND_STEERING
+	struct netlink_kernel_cfg cfg = {
+    	.groups = STEERING_GROUP,
+	};
+
+	pAd->netlink_sock = netlink_kernel_create(&init_net, NETLINK_STEERING, &cfg);
+	if (!pAd->netlink_sock) {
+		MTWF_DBG(pAd, DBG_CAT_INIT, DBG_SUBCAT_ALL, DBG_LVL_ERROR, "Failed to create band steering netlink socket.\n");
+	}
+#endif /* BAND_STEERING */
+
 	return NDIS_STATUS_SUCCESS;
 }
 
