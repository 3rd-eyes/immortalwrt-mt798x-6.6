+					 "Steering STA "MACSTR", RSSI SteeringThreshold Thres[%d]-[%d]\n",
+					  MAC2STR(pEntry->Addr), pMbss->SteeringThreshold,	avgRssi);
+    		char if_name[IFNAMSIZ];
